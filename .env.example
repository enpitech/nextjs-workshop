# Optional. Only /submit reads it.
# Without a key the page still works: it asks you to choose the track.
# Get a key at https://console.typesafe.ai and copy this file to .env.local
TYPESAFE_API_KEY=

# Optional. Only the eve agent in agent/ reads it, and only after you set a real model
# in agent/agent.ts. The scripted model needs no key.
AI_GATEWAY_API_KEY=
